# Rendered by the nginx image entrypoint (envsubst) into /etc/nginx/conf.d at start-up.
# SPEC-0001 SEC-18: sole published service; overwrites forwarding headers; rejects unknown hosts.

server_tokens off;

server {
    listen 8080 default_server;
    server_name _;
    # Unknown Host header: close the connection without a response.
    return 444;
}

server {
    listen 8080;
    server_name ${NGINX_SERVER_NAME};

    client_max_body_size 1m;

    # Overwrite, never append: clients cannot inject forwarding or correlation data.
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header Forwarded "";
    proxy_set_header X-Request-ID $request_id;
    proxy_hide_header X-Powered-By;

    proxy_connect_timeout 5s;
    proxy_read_timeout 35s;

    location /api/ {
        proxy_pass http://backend:8000;
    }

    location / {
        proxy_pass http://frontend:3000;
    }
}
