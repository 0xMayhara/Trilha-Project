# Copy to .env and replace every change-me value. Never commit .env.
# Generate secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"

# Django (config.settings.dev for local use; production uses config.settings.prod behind TLS)
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost
DJANGO_LOG_LEVEL=INFO
# Address users open; set-password links printed by the account commands start with it
# (https required with config.settings.prod)
TRILHA_BASE_URL=http://localhost:8080

# Compose project: set it explicitly so every command and script targets the same volumes.
# Existing installations keep the project that already owns their data (see README).
# COMPOSE_PROJECT_NAME=trilha

# PostgreSQL (SPEC-0013). Every password must differ.
# Superuser: used only inside the database container (provisioning, backups).
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
POSTGRES_DB=trilha
# Schema owner: runs migrations only (migrate service). Existing installations keep their name.
POSTGRES_USER=trilha
POSTGRES_PASSWORD=change-me-owner
# Runtime role used by backend and worker: owns nothing, restricted grants.
POSTGRES_RUNTIME_USER=trilha_app
POSTGRES_RUNTIME_PASSWORD=change-me-runtime

# Audit content digest keys (SPEC-0007 SEC-53), given to the backend only. Comma-separated id:key
# pairs; each key is 32 random bytes in base64url, generated with:
#   python3 -c "import base64, secrets; print('k1:' + base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Rotate by appending a new pair and switching the active ID. Keep older pairs while the audit events
# they signed are retained, and back the keys up apart from database dumps.
AUDIT_DIGEST_KEYS=k1:change-me
AUDIT_DIGEST_ACTIVE_KEY_ID=k1

# Redis
REDIS_PASSWORD=change-me

# Reverse proxy
NGINX_SERVER_NAME=localhost
PROXY_BIND=127.0.0.1
PROXY_PORT=8080
