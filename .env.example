# Copy to .env and replace every change-me value. Never commit .env.
# Generate secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"

# Django (config.settings.dev for local use; production uses config.settings.prod behind TLS)
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost
DJANGO_LOG_LEVEL=INFO

# PostgreSQL superuser (used only inside the database container)
POSTGRES_SUPERUSER_PASSWORD=change-me
# Application role (least privilege, created on first start)
POSTGRES_DB=trilha
POSTGRES_USER=trilha
POSTGRES_PASSWORD=change-me

# Redis
REDIS_PASSWORD=change-me

# Reverse proxy
NGINX_SERVER_NAME=localhost
PROXY_BIND=127.0.0.1
PROXY_PORT=8080
